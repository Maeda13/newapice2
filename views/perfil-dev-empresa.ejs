<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%- include('partials/tema-head') %>
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <title>Perfil do Desenvolvedor — Ápice</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/dev.css" />
  <link rel="stylesheet" href="/css/perfil-dev-empresa.css" />
</head>
<body>

  <%- include('partials/header-company', { currentPage: 'empresa-devs' }) %>

  <main class="page-content pde" id="main-content">

    <section id="state-loading" class="pde-estado" role="status" aria-live="polite">
      <span class="spinner" aria-hidden="true"></span>
      <p>Carregando perfil...</p>
    </section>

    <section id="state-error" class="pde-estado" role="alert" hidden>
      <p id="error-msg">Erro ao carregar perfil.</p>
      <a href="/empresa/desenvolvedores" class="pde-voltar">← Voltar à lista</a>
    </section>

    <article id="state-content" hidden>

      <a href="/empresa/desenvolvedores" class="pde-voltar" aria-label="Voltar para a lista de desenvolvedores">
        <svg width="14" height="14" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M11 4L6 9L11 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Voltar
      </a>

      <!-- ══ Hero ══ -->
      <section class="pde-card pde-hero" aria-label="Resumo do candidato">
        <img class="pde-avatar" id="hero-avatar-img" hidden alt="" />
        <span class="pde-avatar" id="hero-avatar" aria-hidden="true"></span>
        <header class="pde-hero__main">
          <h1 class="pde-nome" id="hero-name">—</h1>
          <a class="pde-github" id="hero-github" href="#" target="_blank" rel="noopener noreferrer">—</a>
          <ul class="pde-chips" id="hero-chips" aria-label="Destaques do candidato"></ul>
        </header>
        <div class="pde-hero__lado">
          <ul class="pde-stats" id="hero-stats" aria-label="Resumo das habilidades"></ul>
          <button class="pde-contato" id="btn-contact" type="button">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            Enviar mensagem
          </button>
        </div>
      </section>

      <!-- ══ Habilidades ══ -->
      <section class="pde-secao" aria-labelledby="titulo-habilidades">
        <h2 class="pde-titulo" id="titulo-habilidades">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.1 8.6 22 9.3 16.8 14 18.2 21 12 17.5 5.8 21 7.2 14 2 9.3 8.9 8.6 12 2"/></svg>
          Habilidades
        </h2>
        <%# Língua estrangeira, escolaridade e instituição ainda não são coletadas no cadastro do dev %>
        <dl class="pde-info">
          <div class="pde-info__card"><dt>Língua estrangeira</dt><dd>Não informado</dd></div>
          <div class="pde-info__card"><dt>Escolaridade</dt><dd>Não informado</dd></div>
          <div class="pde-info__card"><dt>Instituição</dt><dd>Não informado</dd></div>
        </dl>
      </section>

      <!-- ══ Tecnologias conhecidas ══ -->
      <section class="pde-card pde-tecnologias pde-secao" aria-labelledby="titulo-tecnologias">
        <h2 class="pde-titulo" id="titulo-tecnologias">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.1 8.6 22 9.3 16.8 14 18.2 21 12 17.5 5.8 21 7.2 14 2 9.3 8.9 8.6 12 2"/></svg>
          Tecnologias conhecidas
        </h2>
        <ul class="pde-tech-lista" id="skills-grid"></ul>
      </section>

      <!-- ══ Repositórios ══ -->
      <section class="pde-secao" aria-labelledby="titulo-repositorios">
        <h2 class="pde-titulo" id="titulo-repositorios">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.1 8.6 22 9.3 16.8 14 18.2 21 12 17.5 5.8 21 7.2 14 2 9.3 8.9 8.6 12 2"/></svg>
          Repositórios
        </h2>
        <ul class="pde-repos" id="repos-grid"></ul>
      </section>

      <!-- ══ Progresso em roadmaps (só se o dev tem roadmap de alguma vaga desta empresa) ══ -->
      <section class="pde-secao" id="section-roadmap" aria-labelledby="titulo-roadmap" hidden>
        <h2 class="pde-titulo" id="titulo-roadmap">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 9h12M9 3l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Progresso em roadmaps
        </h2>
        <ul class="pde-roadmaps" id="roadmap-list"></ul>
      </section>

    </article>

  </main>

  <script src="/js/escape-html.js"></script>
  <script>
    const LEVEL_LABEL = { estagio: "Estágio", junior: "Júnior", pleno: "Pleno" };
    const AVATAR_COLORS = [
      "linear-gradient(135deg,#04A07D,#10b691)",
      "linear-gradient(135deg,#10b691,#60a5fa)",
      "linear-gradient(135deg,#f59e0b,#ef4444)",
      "linear-gradient(135deg,#ec4899,#04A07D)",
      "linear-gradient(135deg,#06b6d4,#10b691)",
      "linear-gradient(135deg,#84cc16,#10b691)",
    ];
    const ICONE_INFO = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>`;
    const ICONE_REPO = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>`;

    function initials(name) {
      return (name || "?").split(" ").slice(0, 2).map(w => w[0]).join("").toUpperCase();
    }

    // "Atualizado há 2 dias" a partir de uma data ISO
    function haQuanto(raw) {
      if (!raw) return null;
      const dias = Math.max(0, Math.floor((Date.now() - new Date(raw).getTime()) / 86400000));
      if (Number.isNaN(dias)) return null;
      if (dias === 0) return "hoje";
      if (dias === 1) return "há 1 dia";
      if (dias < 30) return `há ${dias} dias`;
      const meses = Math.floor(dias / 30);
      if (meses < 12) return meses === 1 ? "há 1 mês" : `há ${meses} meses`;
      const anos = Math.floor(meses / 12);
      return anos === 1 ? "há 1 ano" : `há ${anos} anos`;
    }

    let currentDev = null;

    async function init() {
      const devId = <%= devId %>;
      try {
        const uRes = await fetch("/api/user");
        if (!uRes.ok) { window.location.href = `/login?tipo=empresa&next=${encodeURIComponent(location.pathname + location.search)}`; return; }
        const user = await uRes.json();
        if (user.type !== "empresa") { window.location.href = "/dashboard"; return; }

        const dRes = await fetch(`/api/empresa/dev/${devId}`);
        if (!dRes.ok) {
          const body = await dRes.json().catch(() => ({}));
          throw new Error(body.error || "Desenvolvedor não encontrado.");
        }
        render(await dRes.json());
      } catch (e) {
        document.getElementById("error-msg").textContent = e.message || "Erro ao carregar perfil.";
        document.getElementById("state-loading").hidden = true;
        document.getElementById("state-error").hidden   = false;
      }
    }

    function render(dev) {
      currentDev = dev;

      const avatarPh  = document.getElementById("hero-avatar");
      const avatarImg = document.getElementById("hero-avatar-img");
      // As iniciais ficam prontas embaixo: se a foto não carregar, elas voltam.
      avatarPh.style.background = AVATAR_COLORS[Math.abs(dev.id ?? 0) % AVATAR_COLORS.length];
      avatarPh.textContent = initials(dev.name);
      if (dev.avatar_url) {
        avatarImg.addEventListener("error", () => { avatarImg.hidden = true; avatarPh.hidden = false; }, { once: true });
        avatarImg.referrerPolicy = "no-referrer";
        avatarImg.src = dev.avatar_url;
        avatarImg.alt = `Foto de ${dev.name || "perfil"}`;
        avatarImg.hidden = false;
        avatarPh.hidden = true;
      }

      document.getElementById("hero-name").textContent = dev.name || "—";

      const ghEl = document.getElementById("hero-github");
      if (dev.github) {
        ghEl.href        = `https://github.com/${encodeURIComponent(dev.github)}`;
        ghEl.textContent = `@${dev.github}`;
        ghEl.setAttribute("aria-label", `GitHub de ${dev.name}`);
      } else {
        ghEl.removeAttribute("href");
        ghEl.textContent = "GitHub não vinculado";
      }

      const chips = [`<li class="pde-chip pde-chip--destaque">${escapeHtml(LEVEL_LABEL[dev.level] ?? dev.level)}</li>`];
      if (dev.isPro) chips.push(`<li class="pde-chip" title="Perfil em destaque (plano PRO)">★ PRO</li>`);
      if (dev.match != null) chips.push(`<li class="pde-chip">${Number(dev.match)}% compatível</li>`);
      if (dev.best_job) chips.push(`<li class="pde-chip">Vaga mais compatível: ${escapeHtml(dev.best_job)}</li>`);
      if (dev.created_at) {
        const desde = new Date(dev.created_at).toLocaleDateString("pt-BR", { month: "long", year: "numeric", timeZone: "UTC" });
        chips.push(`<li class="pde-chip pde-chip--mudo">Entrou em ${escapeHtml(desde)}</li>`);
      }
      document.getElementById("hero-chips").innerHTML = chips.join("");

      const skills = dev.skills ?? [];
      const dominadas = skills.filter(s => s.confidence >= 60).length; // mesma regra do perfil do próprio dev
      document.getElementById("hero-stats").innerHTML = `
        <li class="pde-stat"><span class="pde-stat__valor">${skills.length}</span><span class="pde-stat__rotulo">habilidades</span></li>
        <li class="pde-stat"><span class="pde-stat__valor">${dominadas}</span><span class="pde-stat__rotulo">dominadas</span></li>`;

      renderSkills(skills);
      renderRepos(dev.repos ?? []);
      renderRoadmaps(dev.roadmaps ?? []);

      document.getElementById("state-loading").hidden = true;
      document.getElementById("state-content").hidden = false;
    }

    function renderSkills(skills) {
      const lista = document.getElementById("skills-grid");
      if (!skills.length) {
        lista.innerHTML = '<li class="pde-vazio">Nenhuma tecnologia detectada ainda.</li>';
        return;
      }
      lista.innerHTML = skills.slice(0, 24).map((s, i) => {
        const origem = s.source === "manual" ? "declarada" : "detectada no GitHub";
        const declarada = origem === "declarada";
        const detalhe = declarada
          ? `Declarada pelo próprio candidato · nível ${s.confidence}%`
          : `Detectada no código dos repositórios do candidato no GitHub · confiança ${s.confidence}%`;
        return `
        <li class="pde-tech">
          <span class="pde-tech__nome" title="${escapeHtml(s.name)}">${escapeHtml(s.name)}</span>
          <span class="pde-tech__pct">${s.confidence}%</span>
          <span class="pde-tech__origem ${declarada ? "pde-tech__origem--declarada" : "pde-tech__origem--github"}">${origem}</span>
          <button type="button" class="pde-tech__info" aria-expanded="false" aria-controls="tech-detalhe-${i}" aria-label="Sobre ${escapeHtml(s.name)}">${ICONE_INFO}</button>
          <p class="pde-tech__detalhe" id="tech-detalhe-${i}" hidden>${escapeHtml(detalhe)}</p>
        </li>`;
      }).join("");

      lista.querySelectorAll(".pde-tech__info").forEach(btn => {
        btn.addEventListener("click", () => {
          const aberto = btn.getAttribute("aria-expanded") === "true";
          btn.setAttribute("aria-expanded", String(!aberto));
          document.getElementById(btn.getAttribute("aria-controls")).hidden = aberto;
        });
      });
    }

    function renderRepos(repos) {
      const lista = document.getElementById("repos-grid");
      if (!repos.length) {
        lista.innerHTML = '<li class="pde-vazio">O candidato ainda não publicou repositórios no perfil.</li>';
        return;
      }
      lista.innerHTML = repos.map(r => {
        const nome = escapeHtml(r.name);
        const atualizado = haQuanto(r.updated_at);
        // só caminhos "dono/repositório" válidos viram link
        const link = /^[\w-][\w.-]*\/(?!\.+$)[\w.-]+$/.test(r.full_name || "")
          ? `<a class="pde-repo__ver" href="https://github.com/${escapeHtml(r.full_name)}" target="_blank" rel="noopener noreferrer" aria-label="Ver repositório ${nome} no GitHub">Ver repositório</a>`
          : "";
        return `
        <li>
          <article class="pde-repo">
            <header class="pde-repo__topo">${ICONE_REPO}<h3 class="pde-repo__nome">${nome}</h3></header>
            <p class="pde-repo__desc">${r.description ? escapeHtml(r.description) : "Sem descrição."}</p>
            <ul class="pde-repo__meta">
              <li class="pde-repo__publico">Público</li>
              ${atualizado ? `<li>Atualizado ${atualizado}</li>` : ""}
            </ul>
            ${link}
          </article>
        </li>`;
      }).join("");
    }

    function renderRoadmaps(roadmaps) {
      if (!roadmaps.length) return;
      const section = document.getElementById("section-roadmap");
      const list    = document.getElementById("roadmap-list");
      section.hidden = false;
      list.innerHTML = roadmaps.map(r => {
        const titulo = r.job_title ? escapeHtml(r.job_title) : `Vaga #${r.job_id}`;
        return `
        <li class="pde-roadmap">
          <span class="pde-roadmap__vaga">${titulo}</span>
          <span class="pde-roadmap__barra" role="progressbar" aria-valuenow="${r.progress}" aria-valuemin="0" aria-valuemax="100" aria-label="Progresso em ${titulo}">
            <span class="pde-roadmap__preenchido" style="width:0%;display:block" data-w="${r.progress}%"></span>
          </span>
          <span class="pde-roadmap__pct">${r.progress}%</span>
        </li>`;
      }).join("");

      requestAnimationFrame(() => requestAnimationFrame(() => {
        list.querySelectorAll(".pde-roadmap__preenchido[data-w]").forEach(el => { el.style.width = el.dataset.w; });
      }));
    }

    // ── Contato: abre (ou reaproveita) a conversa com o candidato ──
    document.getElementById("btn-contact").addEventListener("click", async function () {
      if (!currentDev?.github_id) return;
      this.disabled = true;
      const original = this.innerHTML;
      this.textContent = "Abrindo conversa...";
      try {
        const res = await fetch("/api/messages/conversations", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ dev_github_id: currentDev.github_id }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Erro ao iniciar conversa.");
        window.location.href = `/empresa/mensagens?conv=${data.conversation_id}`;
      } catch (e) {
        this.disabled = false;
        this.innerHTML = original;
        alert(e.message || "Erro ao iniciar conversa.");
      }
    });

    init();
  </script>

<%- include('partials/vlibras') %>
</body>
</html>
