<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%- include('partials/tema-head') %>
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Encontre vagas de estágio e emprego para desenvolvedores, veja o roadmap de habilidades e candidate-se com confiança." />
  <title>Ápice — Vagas para Desenvolvedores</title>
  <meta name="robots" content="index, follow" />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content="Ápice" />
  <meta property="og:url"         content="https://newapice22.onrender.com/vagas" />
  <meta property="og:title"       content="Vagas para Desenvolvedores — Ápice" />
  <meta property="og:description" content="Encontre vagas de estágio e emprego em tech. Cada vaga tem um roadmap personalizado baseado no seu GitHub." />
  <meta property="og:locale"      content="pt_BR" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content="Vagas para Desenvolvedores — Ápice" />
  <meta name="twitter:description" content="Encontre vagas de estágio e emprego em tech com roadmap personalizado." />

  <!-- Canonical -->
  <link rel="canonical" href="https://newapice22.onrender.com/vagas" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/vagas.css" />
</head>
<% const isEmpresa = locals.viewer === 'empresa'; %>
<body class="vagas-pagina<%= isEmpresa ? ' vagas-pagina--empresa' : '' %>">

<% if (isEmpresa) { %>
  <%- include('partials/header-company', { currentPage: 'empresa-vagas' }) %>
<% } else if (locals.user) { %>
  <%- include('partials/header-dev', { currentPage: 'vagas' }) %>
<% } else { %>
  <%- include('partials/header') %>
<% } %>

<%
  const vagas = locals.vagas || [];
  const NIVEIS = [["todos", "Todos"], ["estagio", "Estágio"], ["junior", "Júnior"], ["pleno", "Pleno"]];
  const AREAS  = [["todas", "Todos"], ["backend", "Backend"], ["frontend", "Frontend"], ["fullstack", "Fullstack"]];
  const ORDENS = [["recentes", "Mais recentes"], ["titulo", "A → Z"], ["empresa", "Por empresa"]];
  const contagem = (n) => `${n} vaga${n === 1 ? "" : "s"} encontrada${n === 1 ? "" : "s"}`;
%>
<main class="vagas" id="main-content">

  <% if (isEmpresa) { %>
  <%# Voltar (padrão do site: seta + texto, no canto). Usa a página anterior; sem histórico (ou sem JS), cai em Gerenciar vagas %>
  <a href="/empresa/vagas" class="vagas-voltar" id="vagas-voltar">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="15 5 8 12 15 19"/></svg>
    Voltar
  </a>
  <% } %>

  <!-- ══════════ HERO ══════════ -->
  <header class="vagas-hero">
    <% if (isEmpresa) { %>
    <h1 class="vagas-hero__titulo">Veja como o mercado <span class="vagas-hero__vaga">anuncia</span><br> as <span class="vagas-hero__roadmap">vagas</span></h1>
    <p class="vagas-hero__sub">Vitrine pública vista pelos desenvolvedores. Use como referência para as suas vagas.</p>
    <% } else { %>
    <h1 class="vagas-hero__titulo">Encontre sua <span class="vagas-hero__vaga">vaga</span>,<br> veja o <span class="vagas-hero__roadmap">roadmap</span> exato</h1>
    <p class="vagas-hero__sub">Cada vaga tem uma trilha de aprendizado personalizada para o seu perfil. Saiba exatamente o que estudar antes de candidatar.</p>
    <% } %>
  </header>

  <!-- ══════════ BUSCA E FILTROS ══════════
       Sem JS, a busca envia ?q= e a página mostra todas as vagas; com JS, busca,
       nível, área e ordem filtram na hora e ficam na URL (dá para compartilhar). -->
  <form class="vagas-filtros" role="search" aria-label="Buscar e filtrar vagas" action="/vagas" method="get" id="vagas-filtros">
    <label class="vagas-busca">
      <svg class="vagas-busca__icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7.5"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
      <span class="vagas-sr">Buscar vagas</span>
      <input type="search" name="q" id="vagas-q" class="vagas-busca__campo" placeholder="Buscar por título, empresa ou skill" autocomplete="off" />
    </label>

    <fieldset class="vagas-chips" data-grupo="nivel">
      <legend class="vagas-sr">Nível</legend>
      <% NIVEIS.forEach(([valor, rotulo]) => { %>
      <button type="button" class="vagas-chip" data-valor="<%= valor %>" aria-pressed="<%= valor === 'todos' %>"><%= rotulo %></button>
      <% }) %>
    </fieldset>

    <fieldset class="vagas-chips" data-grupo="area">
      <legend class="vagas-sr">Área</legend>
      <% AREAS.forEach(([valor, rotulo]) => { %>
      <button type="button" class="vagas-chip" data-valor="<%= valor %>" aria-pressed="<%= valor === 'todas' %>"><%= rotulo %></button>
      <% }) %>
    </fieldset>
  </form>

  <!-- ══════════ RESULTADOS ══════════ -->
  <section class="vagas-resultados" aria-labelledby="vagas-contador">
    <header class="vagas-resultados__topo">
      <p class="vagas-contador" id="vagas-contador" aria-live="polite"><%= contagem(vagas.length) %></p>
      <label class="vagas-ordem">
        <span class="vagas-sr">Ordenar vagas</span>
        <select class="vagas-ordem__campo" id="vagas-ordem" name="ordem" form="vagas-filtros">
          <% ORDENS.forEach(([valor, rotulo]) => { %><option value="<%= valor %>"><%= rotulo %></option><% }) %>
        </select>
        <svg class="vagas-ordem__seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="5 9 12 16 19 9"/></svg>
      </label>
    </header>

    <% if (vagas.length) { %>
    <ul class="vagas-grade" id="vagas-grade">
      <% vagas.forEach(vaga => { %>
      <li class="vagas-grade__item"
          data-nivel="<%= vaga.nivel %>" data-area="<%= vaga.area || '' %>" data-busca="<%= vaga.busca %>"
          data-publicada="<%= vaga.publicada %>" data-titulo="<%= vaga.titulo %>" data-empresa="<%= vaga.empresa.nome %>">
        <article class="vagas-card" aria-labelledby="vaga-<%= vaga.id %>-titulo">
          <header class="vagas-card__topo">
            <% if (vaga.empresa.logo) { %>
            <img class="vagas-logo" src="<%= vaga.empresa.logo %>" alt="<%= vaga.empresa.nome %>" width="50" height="50" loading="lazy" />
            <% } else { %>
            <span class="vagas-logo vagas-logo--iniciais" role="img" aria-label="<%= vaga.empresa.nome %>"><%= vaga.empresa.iniciais %></span>
            <% } %>
            <h2 class="vagas-card__titulo" id="vaga-<%= vaga.id %>-titulo"><%= vaga.titulo %></h2>
          </header>
          <% if (vaga.resumo) { %><p class="vagas-card__resumo"><%= vaga.resumo %></p><% } %>
          <% const chips = [vaga.cidade, vaga.modalidade, vaga.tag].filter(Boolean); %>
          <% if (chips.length) { %>
          <ul class="vagas-card__chips" aria-label="Local, modalidade e perfil da vaga">
            <% chips.forEach(c => { %><li class="vagas-card__chip" title="<%= c %>"><%= c %></li><% }) %>
          </ul>
          <% } %>
          <% if (vaga.skills.length) { %>
          <h3 class="vagas-card__hab" id="vaga-<%= vaga.id %>-hab">Habilidades</h3>
          <ul class="vagas-card__chips vagas-card__chips--skills" aria-labelledby="vaga-<%= vaga.id %>-hab">
            <% vaga.skills.forEach((s, i) => { %><li class="vagas-card__chip" title="<%= vaga.skillsCompletas[i] %>"><%= s %></li><% }) %>
          </ul>
          <% } %>
          <% if (vaga.match) { %>
          <p class="vagas-card__match" id="vaga-<%= vaga.id %>-match"><%= vaga.match.pct %>% de match</p>
          <meter class="vagas-card__barra faixa-<%= vaga.match.faixa %>" min="0" max="100" value="<%= vaga.match.pct %>" aria-labelledby="vaga-<%= vaga.id %>-match"><%= vaga.match.pct %>%</meter>
          <% } %>
          <a class="vagas-card__botao" href="/vagas/<%= vaga.id %>"><%= isEmpresa ? 'Ver detalhes da vaga' : 'Ver vaga e se candidatar' %><span class="vagas-sr">: <%= vaga.titulo %></span></a>
        </article>
      </li>
      <% }) %>
    </ul>
    <p class="vagas-vazio" id="vagas-vazio" role="status" hidden>Nenhuma vaga encontrada. Tente outros termos ou limpe os filtros.</p>
    <% } else { %>
    <p class="vagas-vazio" role="status"><%= locals.erro ? 'Não foi possível carregar as vagas agora. Tente de novo em instantes.' : 'Nenhuma vaga aberta no momento. Volte em breve!' %></p>
    <% } %>
  </section>
</main>

<script>
// "Voltar": página anterior do histórico, quando veio de uma página do próprio site.
(function () {
  const voltar = document.getElementById("vagas-voltar");
  if (!voltar) return;
  voltar.addEventListener("click", (e) => {
    let doSite = false;
    try { doSite = document.referrer && new URL(document.referrer).origin === location.origin; } catch (_) {}
    if (doSite && history.length > 1) { e.preventDefault(); history.back(); }
  });
})();
</script>

<script>
// Busca, filtros e ordem da vitrine — só mostram/escondem e reordenam os cards
// que já vieram do servidor (nada de HTML montado aqui), e ficam na URL.
(function () {
  const grade = document.getElementById("vagas-grade");
  if (!grade) return;
  const itens    = [...grade.children];
  const form     = document.getElementById("vagas-filtros");
  const campo    = document.getElementById("vagas-q");
  const ordem    = document.getElementById("vagas-ordem");
  const contador = document.getElementById("vagas-contador");
  const vazio    = document.getElementById("vagas-vazio");
  const normalizar = (t) => String(t || "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();

  const url = new URLSearchParams(location.search);
  const estado = {
    q:     url.get("q") || "",
    nivel: url.get("nivel") || "todos",
    area:  url.get("area") || "todas",
    ordem: url.get("ordem") || "recentes",
  };
  const valido = (grupo, v) => form.querySelector(`[data-grupo="${grupo}"] [data-valor="${v}"]`);
  if (!valido("nivel", estado.nivel)) estado.nivel = "todos";
  if (!valido("area", estado.area)) estado.area = "todas";
  if (![...ordem.options].some(o => o.value === estado.ordem)) estado.ordem = "recentes";
  campo.value = estado.q;
  ordem.value = estado.ordem;

  const comparar = {
    recentes: (a, b) => Number(b.dataset.publicada) - Number(a.dataset.publicada),
    titulo:   (a, b) => a.dataset.titulo.localeCompare(b.dataset.titulo, "pt-BR"),
    empresa:  (a, b) => a.dataset.empresa.localeCompare(b.dataset.empresa, "pt-BR") || a.dataset.titulo.localeCompare(b.dataset.titulo, "pt-BR"),
  };

  function aplicar() {
    const termos = normalizar(estado.q).split(/\s+/).filter(Boolean);
    let n = 0;
    for (const li of itens) {
      const ok = (estado.nivel === "todos" || li.dataset.nivel === estado.nivel)
        && (estado.area === "todas" || li.dataset.area === estado.area)
        && termos.every(t => li.dataset.busca.includes(t));
      li.hidden = !ok;
      if (ok) n++;
    }
    [...itens].sort(comparar[estado.ordem]).forEach(li => grade.appendChild(li));
    contador.textContent = `${n} vaga${n === 1 ? "" : "s"} encontrada${n === 1 ? "" : "s"}`;
    vazio.hidden = n > 0;
    for (const grupo of ["nivel", "area"]) {
      form.querySelectorAll(`[data-grupo="${grupo}"] .vagas-chip`).forEach(b => b.setAttribute("aria-pressed", String(b.dataset.valor === estado[grupo])));
    }
    const p = new URLSearchParams();
    if (estado.q.trim()) p.set("q", estado.q.trim());
    if (estado.nivel !== "todos") p.set("nivel", estado.nivel);
    if (estado.area !== "todas") p.set("area", estado.area);
    if (estado.ordem !== "recentes") p.set("ordem", estado.ordem);
    const qs = p.toString();
    history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
  }

  form.addEventListener("click", (e) => {
    const chip = e.target.closest(".vagas-chip");
    if (!chip) return;
    estado[chip.closest("[data-grupo]").dataset.grupo] = chip.dataset.valor;
    aplicar();
  });
  let espera = null;
  campo.addEventListener("input", () => { estado.q = campo.value; clearTimeout(espera); espera = setTimeout(aplicar, 200); });
  form.addEventListener("submit", (e) => { e.preventDefault(); estado.q = campo.value; aplicar(); });
  ordem.addEventListener("change", () => { estado.ordem = ordem.value; aplicar(); });

  aplicar();
})();
</script>

<%- include('partials/vlibras') %>
</body>
</html>
