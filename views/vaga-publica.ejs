<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%- include('partials/tema-head') %>
  <%
    const d = locals.dados;
    const v = d ? d.vaga : null;
    const descricaoMeta = v
      ? `${v.titulo} na ${v.empresa.nome} — veja as skills exigidas e acesse o roadmap personalizado para se candidatar.`
      : "Veja os detalhes desta vaga, as skills exigidas e acesse o roadmap personalizado para se candidatar — Ápice.";
  %>
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <title><%= v ? `${v.titulo} — Ápice` : "Ápice — Vaga" %></title>
  <meta name="robots" content="<%= v ? 'index, follow' : 'noindex' %>" />
  <meta name="description" content="<%= descricaoMeta %>" />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content="Ápice" />
  <meta property="og:title"       content="<%= v ? `${v.titulo} — Ápice` : 'Vaga — Ápice' %>" />
  <meta property="og:description" content="<%= descricaoMeta %>" />
  <meta property="og:locale"      content="pt_BR" />
  <% if (v) { %><meta property="og:url" content="<%= locals.origem %>/vagas/<%= v.id %>" />
  <link rel="canonical" href="<%= locals.origem %>/vagas/<%= v.id %>" /><% } %>

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary" />
  <meta name="twitter:title"       content="<%= v ? `${v.titulo} — Ápice` : 'Vaga — Ápice' %>" />
  <meta name="twitter:description" content="<%= v ? `Veja os detalhes de ${v.titulo} e acesse o roadmap personalizado.` : 'Veja as skills exigidas e acesse o roadmap personalizado para esta vaga.' %>" />
  <% if (v) {
    // Vaga no formato do Google (JobPosting). "<" escapado para não fechar o <script>.
    const ld = { "@context": "https://schema.org", "@type": "JobPosting", title: v.titulo, description: v.paragrafos.join("\n") || v.titulo,
      hiringOrganization: { "@type": "Organization", name: v.empresa.nome }, url: `${locals.origem}/vagas/${v.id}` };
    if (v.publicadaIso) ld.datePosted = v.publicadaIso;
    if (v.expiraIso) ld.validThrough = v.expiraIso;
    if (v.local) ld.jobLocation = { "@type": "Place", address: { "@type": "PostalAddress", addressLocality: v.local, addressCountry: "BR" } };
    if (v.salarioMin || v.salarioMax) ld.baseSalary = { "@type": "MonetaryAmount", currency: "BRL",
      value: { "@type": "QuantitativeValue", minValue: v.salarioMin ?? undefined, maxValue: v.salarioMax ?? undefined, unitText: "MONTH" } };
  %>
  <script type="application/ld+json"><%- JSON.stringify(ld).replace(/</g, "\\u003c") %></script>
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/vaga-publica.css" />
</head>
<body class="vaga-pagina<%= locals.viewer === 'empresa' ? ' vaga-pagina--empresa' : '' %>">

<% if (locals.viewer === 'empresa') { %>
  <%- include('partials/header-company', { currentPage: 'empresa-vagas' }) %>
<% } else if (locals.user) { %>
  <%- include('partials/header-dev', { currentPage: 'vagas' }) %>
<% } else { %>
  <%- include('partials/header') %>
<% } %>

<main class="vaga" id="main-content">

  <a href="<%= d && d.isOwner ? '/empresa/vagas' : '/vagas' %>" class="vaga-voltar" id="vagaBack">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="15 5 8 12 15 19"/></svg>
    Voltar
  </a>

<% if (!v) { %>
  <section class="vaga-cartao vaga-erro" id="state-error" aria-live="assertive" role="alert">
    <h1 class="vaga-erro__titulo"><%= locals.erro ? 'Não foi possível carregar a vaga' : 'Vaga não encontrada' %></h1>
    <p><%= locals.erro ? 'Tente de novo em instantes.' : 'Ela pode ter sido removida ou o endereço está errado.' %></p>
    <p><a class="vaga-link" href="/vagas">Ver todas as vagas</a></p>
  </section>
<% } else { %>
  <article class="vaga-artigo" aria-labelledby="vaga-titulo">

    <!-- ── Cabeçalho: empresa, título, datas e etiquetas ── -->
    <header class="vaga-cartao vaga-cabecalho">
      <figure class="vaga-empresa">
        <% if (v.empresa.logo) { %>
        <img class="vaga-logo" src="<%= v.empresa.logo %>" alt="" width="126" height="126" />
        <% } else { %>
        <span class="vaga-logo vaga-logo--iniciais" aria-hidden="true"><%= v.empresa.iniciais %></span>
        <% } %>
        <figcaption class="vaga-empresa__nome"><%= v.empresa.nome %></figcaption>
      </figure>
      <hgroup class="vaga-cabecalho__texto">
        <h1 class="vaga-titulo" id="vaga-titulo"><%= v.titulo %></h1>
        <p class="vaga-datas">
          <% if (v.publicadaEm) { %><span>Publicada em <time datetime="<%= v.publicadaIso || '' %>"><%= v.publicadaEm %></time></span><% } %>
          <% if (v.inscricoesAte) { %><span>Inscrições até <time datetime="<%= v.expiraIso || '' %>"><%= v.inscricoesAte %></time></span><% } %>
        </p>
      </hgroup>
      <% const etiquetas = [v.local, v.modalidade, ...v.tags, v.nivel].filter(Boolean); %>
      <% if (etiquetas.length) { %>
      <ul class="vaga-chips" aria-label="Local, modalidade, perfil e nível da vaga">
        <% etiquetas.forEach(e => { %><li class="vaga-chip"><%= e %></li><% }) %>
      </ul>
      <% } %>
    </header>

    <!-- ── Seu match com a vaga (dev e visitante; empresa não tem match) ── -->
    <% const m = d.match; %>
    <% if (m) { %>
    <section class="vaga-cartao vaga-match faixa-<%= m.faixa %>" aria-labelledby="match-titulo">
      <header class="vaga-match__topo">
        <h2 class="vaga-match__titulo" id="match-titulo">Seu match com a vaga</h2>
        <p class="vaga-match__pct"><%= m.total %>%</p>
      </header>
      <meter class="vaga-barra" min="0" max="100" value="<%= m.total %>" aria-labelledby="match-titulo"><%= m.total %>%</meter>
      <% if (m.convite) { %>
      <p class="vaga-match__msg"><%= m.convite.texto %> <a class="vaga-link" href="<%= m.convite.link %>"><%= m.convite.acao %></a></p>
      <% } else { %>
      <p class="vaga-match__msg"><%= m.mensagem %></p>
      <% } %>
      <ul class="vaga-match__partes">
        <li class="vaga-parte faixa-<%= m.skills.faixa %>">
          <h3 class="vaga-parte__rotulo" id="match-skills">Skills</h3>
          <p class="vaga-parte__pct"><%= m.skills.pct %>%</p>
          <meter class="vaga-barra vaga-barra--fina" min="0" max="100" value="<%= m.skills.pct %>" aria-labelledby="match-skills"><%= m.skills.pct %>%</meter>
          <% if (m.skills.itens.length) { %>
          <ul class="vaga-parte__itens">
            <% m.skills.itens.forEach(s => { %>
            <li class="vaga-item<%= s.tem === true ? ' vaga-item--tem' : s.tem === false ? ' vaga-item--falta' : '' %>"><span class="vaga-item__marca" aria-hidden="true"><%= s.tem === true ? '✓' : s.tem === false ? '✕' : '•' %></span> <%= s.nome %><% if (s.tem !== null) { %><span class="vaga-sr"> (<%= s.tem ? 'você tem' : 'falta' %>)</span><% } %></li>
            <% }) %>
          </ul>
          <% } %>
        </li>
        <li class="vaga-parte faixa-<%= m.senioridade.faixa %>">
          <h3 class="vaga-parte__rotulo" id="match-senioridade">Senioridade</h3>
          <p class="vaga-parte__pct"><%= m.senioridade.pct %>%</p>
          <meter class="vaga-barra vaga-barra--fina" min="0" max="100" value="<%= m.senioridade.pct %>" aria-labelledby="match-senioridade"><%= m.senioridade.pct %>%</meter>
          <% if (m.senioridade.requisito) { %>
          <p class="vaga-parte__linha vaga-item<%= m.senioridade.atende === true ? ' vaga-item--tem' : m.senioridade.atende === false ? ' vaga-item--falta' : '' %>"><span class="vaga-item__marca" aria-hidden="true"><%= m.senioridade.atende === true ? '✓' : m.senioridade.atende === false ? '✕' : '•' %></span> Requisito: <%= m.senioridade.requisito %><% if (m.senioridade.atende !== null) { %><span class="vaga-sr"> (<%= m.senioridade.atende ? 'atende' : 'não atende' %>)</span><% } %></p>
          <% } %>
        </li>
      </ul>
    </section>
    <% } %>

    <!-- ── Descrição e responsabilidades | candidatura, dados e benefícios ── -->
    <section class="vaga-corpo" aria-label="Detalhes da vaga">
      <section class="vaga-cartao vaga-texto" aria-labelledby="desc-titulo">
        <h2 class="vaga-texto__titulo" id="desc-titulo">Descrição da vaga</h2>
        <% if (v.paragrafos.length) { %>
          <% v.paragrafos.forEach(p => { %><p class="vaga-texto__par"><%= p %></p><% }) %>
        <% } else { %>
          <p class="vaga-texto__par">A empresa ainda não escreveu a descrição desta vaga.</p>
        <% } %>
        <% if (v.responsabilidades.length) { %>
        <section class="vaga-texto__secao" aria-labelledby="resp-titulo">
          <h2 class="vaga-texto__titulo" id="resp-titulo">Responsabilidades</h2>
          <ul class="vaga-resp">
            <% v.responsabilidades.forEach(r => { %>
            <li class="vaga-resp__item"><% if (r.rotulo) { %><strong class="vaga-resp__rotulo"><%= r.rotulo %>:</strong> <% } %><%= r.texto %></li>
            <% }) %>
          </ul>
        </section>
        <% } %>
      </section>

      <aside class="vaga-lateral" aria-label="Candidatura e informações da vaga">
        <section class="vaga-cartao vaga-acoes" aria-label="Candidatura">
          <% if (d.viewer === 'empresa') { %>
            <% if (d.isOwner) { %>
            <a href="/empresa/vagas/<%= v.id %>/editar" class="vaga-botao vaga-botao--primario">Editar vaga</a>
            <a href="/empresa/vagas" class="vaga-botao vaga-botao--escuro">Candidaturas e gestão</a>
            <a href="/empresa/matchs" class="vaga-botao vaga-botao--escuro">Ver matchs de devs</a>
            <p class="vaga-acoes__nota">Status: <strong><%= v.ativa ? 'Ativa' : 'Inativa' %></strong></p>
            <% } else { %>
            <p class="vaga-acoes__nota">Vaga de outra empresa — visualização somente leitura.</p>
            <a href="/empresa/vagas" class="vaga-botao vaga-botao--escuro">Minhas vagas</a>
            <% } %>
          <% } else if (!v.ativa) { %>
            <p class="vaga-acoes__nota">Esta vaga não está mais recebendo candidaturas.</p>
          <% } else if (d.viewer !== 'dev') { %>
            <a href="/login?next=/vagas/<%= v.id %>" class="vaga-botao vaga-botao--primario">Entrar para se candidatar</a>
          <% } else if (d.applied) { %>
            <button type="button" class="vaga-botao vaga-botao--primario" disabled>Você já se candidatou</button>
          <% } else { %>
            <button type="button" class="vaga-botao vaga-botao--primario" id="btn-apply" data-vaga="<%= v.id %>">Candidatar-se</button>
          <% } %>
          <% if (d.viewer !== 'empresa') { %>
          <a href="<%= d.viewer === 'dev' ? `/trilha/novo?tipo=vaga&vagaId=${v.id}` : `/login?next=/vagas/${v.id}` %>" class="vaga-botao vaga-botao--escuro">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/></svg>
            Gerar roadmap para esta vaga
          </a>
          <% } %>
          <output class="vaga-acoes__aviso" id="apply-aviso" aria-live="polite"></output>
          <% if (v.salario || v.idioma || v.local) { %>
          <dl class="vaga-dados">
            <% if (v.salario) { %><dt>Faixa salarial</dt><dd class="vaga-dados__salario"><%= v.salario %></dd><% } %>
            <% if (v.idioma) { %><dt><%= v.idioma.idioma %></dt><dd><%= v.idioma.nivel %></dd><% } %>
            <% if (v.local) { %><dt>Local</dt><dd><%= v.local %></dd><% } %>
          </dl>
          <% } %>
        </section>

        <% if (v.beneficios.length) { %>
        <section class="vaga-cartao vaga-beneficios" aria-labelledby="benef-titulo">
          <h2 class="vaga-texto__titulo" id="benef-titulo">Benefícios</h2>
          <ul class="vaga-beneficios__lista">
            <% v.beneficios.forEach(b => { %><li><%= b %></li><% }) %>
          </ul>
        </section>
        <% } %>
      </aside>
    </section>
  </article>
<% } %>
</main>

<script>
// "Voltar": usa o histórico quando a página anterior é do próprio site (link
// direto, aba nova ou vindo de fora: o href do link vale como destino).
(function () {
  const voltar = document.getElementById("vagaBack");
  let doSite = false;
  try { doSite = Boolean(document.referrer) && new URL(document.referrer).origin === location.origin; } catch (_) {}
  if (voltar && doSite && history.length > 1) {
    voltar.addEventListener("click", (e) => { e.preventDefault(); history.back(); });
  }
})();

// Candidatura: POST /api/vagas/:id/candidatar (o botão só existe para dev logado que ainda não se candidatou).
(function () {
  const botao = document.getElementById("btn-apply");
  const aviso = document.getElementById("apply-aviso");
  if (!botao) return;
  botao.addEventListener("click", async () => {
    botao.disabled = true;
    botao.textContent = "Enviando...";
    aviso.textContent = "";
    try {
      const res  = await fetch(`/api/vagas/${botao.dataset.vaga}/candidatar`, { method: "POST" });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || "Não foi possível enviar a candidatura. Tente de novo.");
      botao.textContent = "Você já se candidatou";
      aviso.textContent = "Candidatura enviada!";
    } catch (err) {
      botao.disabled = false;
      botao.textContent = "Candidatar-se";
      aviso.textContent = err.message;
    }
  });
})();
</script>

<%- include('partials/vlibras') %>
</body>
</html>
