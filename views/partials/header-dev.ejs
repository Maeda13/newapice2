<%#
  header-dev.ejs — Navbar superior da área do desenvolvedor
  Requer locals: user, currentPage
  CSS: /css/header.css
%>

<a class="skip-link" href="#main-content">Ir para o conteúdo</a>

<header class="site-header site-header--dev" id="site-header" role="banner">

  <%# ── Logo ─────────────────────────────── %>
  <a href="/dashboard" class="site-logo" aria-label="Ápice — painel do desenvolvedor">
    <img src="/images/principal.webp" alt="Ápice" class="nav-logo__img"
         width="90" height="22" loading="eager" />
  </a>

  <%# ── Nav Desktop ────────────────────────── %>
  <nav class="header-nav" aria-label="Menu do desenvolvedor">

    <a href="/dashboard"
       class="header-link<% if (locals.currentPage === 'dashboard') { %> is-active<% } %>"
       <% if (locals.currentPage === 'dashboard') { %>aria-current="page"<% } %>>
      Dashboard
    </a>

    <a href="/vagas"
       class="header-link<% if (locals.currentPage === 'vagas') { %> is-active<% } %>"
       <% if (locals.currentPage === 'vagas') { %>aria-current="page"<% } %>>
      Vagas
    </a>

    <a href="/repositorios"
       class="header-link<% if (locals.currentPage === 'repositorios') { %> is-active<% } %>"
       <% if (locals.currentPage === 'repositorios') { %>aria-current="page"<% } %>>
      Repositórios
    </a>

    <a href="/trilha"
       class="header-link<% if (locals.currentPage === 'trilha') { %> is-active<% } %>"
       <% if (locals.currentPage === 'trilha') { %>aria-current="page"<% } %>>
      Roadmap
    </a>

    <a href="/mentor"
       class="header-link<% if (locals.currentPage === 'mentor') { %> is-active<% } %>"
       <% if (locals.currentPage === 'mentor') { %>aria-current="page"<% } %>>
      Mentor
    </a>

    <a href="/entrevista"
       class="header-link<% if (locals.currentPage === 'entrevista') { %> is-active<% } %>"
       <% if (locals.currentPage === 'entrevista') { %>aria-current="page"<% } %>>
      Entrevista
    </a>

  </nav>

  <%# ── Direita: mensagens + user menu ───── %>
  <nav class="header-right" aria-label="Ações do usuário">

    <% if (locals.user) { %>
    <a href="/mensagens" class="header-msg-btn" aria-label="Mensagens" id="headerMsgBtn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      <span class="header-msg-badge" id="headerMsgBadge" hidden>0</span>
    </a>
    <button class="user-menu-btn" id="userMenuBtn" type="button"
            aria-haspopup="true" aria-expanded="false"
            aria-controls="userMenuList" aria-label="Menu do usuário">
      <% if (user.avatar) { %>
        <img src="<%= user.avatar %>" alt="" class="header-avatar"
             width="26" height="26" loading="lazy" aria-hidden="true"/>
      <% } else { %>
        <span class="header-avatar-placeholder" aria-hidden="true">
          <%= (user.name || 'D').charAt(0).toUpperCase() %>
        </span>
      <% } %>
      <span class="header-username"><%= (user.name || '').split(' ')[0] %></span>
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.4"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <ul class="user-menu-list" id="userMenuList" role="menu">
      <li role="none">
        <a role="menuitem" href="/perfil">Meu perfil</a>
      </li>
      <li role="none">
        <a role="menuitem" href="/repositorios">Repositórios</a>
      </li>
      <li role="none">
        <a role="menuitem" href="/trilha">Roadmap</a>
      </li>
      <li role="none">
        <a role="menuitem" href="/mentor">Mentor de carreira</a>
      </li>
      <li role="none">
        <a role="menuitem" href="/entrevista">Simulador de entrevista</a>
      </li>
      <li role="separator" class="menu-divider" aria-hidden="true"></li>
      <li role="none">
        <a role="menuitem" href="/perfil#conta">Configurações</a>
      </li>
      <li role="none">
        <a role="menuitem" href="/planos">Planos</a>
      </li>
      <li role="none">
        <button role="menuitem" type="button" class="menu-item-toggle" data-a11y="dark-mode"
                aria-pressed="false" onclick="toggleDarkMode()">Modo escuro</button>
      </li>
      <li role="none">
        <button role="menuitem" type="button" class="menu-item-toggle" data-a11y="high-contrast"
                aria-pressed="false" onclick="toggleHighContrast()">Alto contraste</button>
      </li>
      <li role="separator" class="menu-divider" aria-hidden="true"></li>
      <li role="none">
        <form method="POST" action="/auth/logout">
          <button role="menuitem" type="submit" class="menu-item--danger">Sair</button>
        </form>
      </li>
    </ul>
    <% } %>

  </nav>

</header>

<%# ═══ Bottom Nav Mobile (menu principal do dev no celular) ═══
    Mesmos destinos do menu do desktop; fixo na base da tela,
    ao alcance do polegar. Perfil, Mentor, Entrevista, tema e
    Sair ficam no menu do avatar (cabeçalho). %>
<nav class="bottom-nav bottom-nav--dev" aria-label="Navegação principal">

  <a href="/dashboard"
     class="bottom-nav-item<% if (locals.currentPage === 'dashboard') { %> is-active<% } %>"
     <% if (locals.currentPage === 'dashboard') { %>aria-current="page"<% } %>>
    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2.6a1 1 0 0 1 .65.24l8.5 7.2a1 1 0 0 1 .35.76V20a1.5 1.5 0 0 1-1.5 1.5H15v-6.25a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1V21.5H4.5A1.5 1.5 0 0 1 3 20v-9.2a1 1 0 0 1 .35-.76l8-7.2A1 1 0 0 1 12 2.6z"/>
    </svg>
    <span>Home</span>
  </a>

  <a href="/trilha"
     class="bottom-nav-item<% if (locals.currentPage === 'trilha') { %> is-active<% } %>"
     <% if (locals.currentPage === 'trilha') { %>aria-current="page"<% } %>>
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="5" cy="4.5" r="1.8"/>
      <circle cx="19" cy="19.5" r="1.8"/>
      <path d="M6.8 4.5H18a2 2 0 0 1 2 2v2.5a2 2 0 0 1-2 2H6a2 2 0 0 0-2 2v2.5a2 2 0 0 0 2 2h11.2"/>
    </svg>
    <span>Roadmap</span>
  </a>

  <a href="/vagas"
     class="bottom-nav-item<% if (locals.currentPage === 'vagas') { %> is-active<% } %>"
     <% if (locals.currentPage === 'vagas') { %>aria-current="page"<% } %>>
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2.5" y="7" width="19" height="14" rx="2"/>
      <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
      <line x1="8.5" y1="7" x2="8.5" y2="21"/>
      <line x1="15.5" y1="7" x2="15.5" y2="21"/>
    </svg>
    <span>Vagas</span>
  </a>

  <a href="/repositorios"
     class="bottom-nav-item<% if (locals.currentPage === 'repositorios') { %> is-active<% } %>"
     <% if (locals.currentPage === 'repositorios') { %>aria-current="page"<% } %>>
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3.5" width="18" height="17" rx="2"/>
      <line x1="3" y1="8.5" x2="21" y2="8.5"/>
      <polyline points="10 12.5 8 14.5 10 16.5"/>
      <polyline points="14 12.5 16 14.5 14 16.5"/>
    </svg>
    <span>Repositórios</span>
  </a>

  <a href="/mensagens"
     class="bottom-nav-item<% if (locals.currentPage === 'mensagens') { %> is-active<% } %>"
     <% if (locals.currentPage === 'mensagens') { %>aria-current="page"<% } %>>
    <span class="bottom-nav-ico">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
      </svg>
      <span class="bottom-nav-badge" id="bottomNavMsgBadge" hidden>0</span>
    </span>
    <span>Chat</span>
  </a>

</nav>

<script>
(function () {
  // ── Dropdown do usuário ──────────────────────
  const menuBtn  = document.getElementById('userMenuBtn');
  const menuList = document.getElementById('userMenuList');

  function closeMenu() {
    if (!menuBtn || !menuList) return;
    menuBtn.setAttribute('aria-expanded', 'false');
    menuList.classList.remove('is-open');
  }
  function openMenu() {
    menuBtn.setAttribute('aria-expanded', 'true');
    menuList.classList.add('is-open');
    menuList.querySelector('[role="menuitem"]')?.focus();
  }

  if (menuBtn && menuList) {
    menuBtn.addEventListener('click', () =>
      menuBtn.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu()
    );
    document.addEventListener('click', e => {
      if (!menuBtn.contains(e.target) && !menuList.contains(e.target)) closeMenu();
    });
  }

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeMenu();
  });

  // ── Badge de mensagens não lidas (header + aba Chat do mobile) ──
  const msgBadges = ['headerMsgBadge', 'bottomNavMsgBadge']
    .map(id => document.getElementById(id))
    .filter(Boolean);
  if (msgBadges.length) {
    fetch('/api/messages/unread-count')
      .then(r => r.ok ? r.json() : null)
      .then(data => {
        if (!data || !data.count) return;
        for (const b of msgBadges) {
          b.textContent = data.count > 99 ? '99+' : data.count;
          b.hidden = false;
        }
      })
      .catch(() => {});
  }
})();
</script>
<script src="/js/accessibility.js" defer></script>
