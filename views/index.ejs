        <a href="/" class="logo" aria-label="Ápice">
          <img src="/images/logo.svg" alt="" width="22" height="22" aria-hidden="true" />
          <span class="logo-text">ÁPICE</span>
        </a>
        <p class="ft-tagline">Conectamos talentos.<br>Geramos oportunidades.</p>
      </div>

      <nav class="ft-col" aria-label="Plataforma">
        <p class="ft-col-title">Plataforma</p>
        <ul role="list">
          <li><a href="#como-funciona">Como funciona</a></li>
          <li><a href="/vagas">Ver vagas</a></li>
          <li><a href="/cadastro">Criar conta</a></li>
          <li><a href="/login?tipo=empresa">Para empresas</a></li>
        </ul>
      </nav>

      <nav class="ft-col" aria-label="Produto">
        <p class="ft-col-title">Produto</p>
        <ul role="list">
          <li><a href="/cadastro">Análise de GitHub</a></li>
          <li><a href="/vagas">Match de Skills</a></li>
          <li><a href="/cadastro">Roadmap</a></li>
          <li><a href="/cadastro">Dashboard</a></li>
        </ul>
      </nav>

      <nav class="ft-col" aria-label="Acesso">
        <p class="ft-col-title">Acesso</p>
        <ul role="list">
          <li><a href="/login">Entrar</a></li>
